{
  "name": "akash-roy-digital-lab",
  "version": "1.0.0",
  "private": true,
  "description": "AKASH ROY — DIGITAL LAB. Full-stack portfolio, research archive, achievements gallery, educational blog and private CMS.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:reset-password": "tsx scripts/create-admin.ts --reset",
    "import:certificates": "tsx --conditions=react-server scripts/import-certificates.ts",
    "media:cleanup": "tsx scripts/cleanup-orphans.ts",
    "zip": "node scripts/package-zip.mjs",
    "zip:verify": "node scripts/verify-zip.mjs",
    "postinstall": "prisma generate && node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "hast-util-to-string": "3.0.1",
    "katex": "0.16.25",
    "mermaid": "11.12.1",
    "motion": "12.43.0",
    "next": "15.5.28",
    "nodemailer": "7.0.13",
    "pdfjs-dist": "5.4.394",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "rehype-autolink-headings": "7.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "sharp": "0.34.5",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@napi-rs/canvas": "0.1.81",
    "@playwright/test": "1.56.1",
    "@tailwindcss/typography": "0.5.19",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "22.18.12",
    "@types/nodemailer": "7.0.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
