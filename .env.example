# ─────────────────────────────────────────────────────────────
# AKASH ROY — DIGITAL LAB · environment configuration
# Copy to `.env` and fill in. Placeholders only — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (docker compose up -d starts one on localhost:5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digital_lab?schema=public"
# Integration tests (database name must contain "test") and E2E tests (must contain "e2e")
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/digital_lab_test?schema=public"
DATABASE_URL_E2E="postgresql://postgres:postgres@localhost:5432/digital_lab_e2e?schema=public"

# Public origin used for canonical URLs, sitemap, feeds and Open Graph (no trailing slash)
SITE_URL="http://localhost:3000"

# Security
# Long random string (≥16 chars) used to hash visitor IPs. REQUIRED in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_HASH_SALT="replace-with-a-long-random-string"
SESSION_TTL_HOURS="12"
# "standard" (static CSP) or "strict" (per-request nonce + strict-dynamic)
CSP_MODE="standard"
# Set to "true" only behind a proxy you control that sets X-Forwarded-For (Vercel, Nginx, Caddy…)
TRUST_PROXY="false"

# Media storage: "local" (development, files in ./storage) or "s3" (production)
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, Backblaze B2). The bucket must be PRIVATE.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
S3_SIGNED_URL_TTL="300"
# Origin of signed media URLs, added to the CSP img/media/frame sources, e.g. https://<account>.r2.cloudflarestorage.com
MEDIA_ORIGIN=""

# Upload limits (MB)
MAX_IMAGE_MB="15"
MAX_PDF_MB="20"
MAX_VIDEO_MB="200"

# Email: "none" | "console" (log only) | "smtp"
EMAIL_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Digital Lab <no-reply@example.com>"
# Where contact-form notifications are sent (messages are always stored in the admin inbox)
CONTACT_TO=""

# Admin bootstrap (optional, for non-interactive environments only — prefer the interactive prompt)
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
